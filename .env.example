# Copy to .env.local and fill in. Never commit real values.

# --- Storyblok (content) ------------------------------------------------------
STORYBLOK_SPACE_ID=
STORYBLOK_REGION=eu                   # eu | us | ca | ap | cn
STORYBLOK_PREVIEW_TOKEN=              # Preview access token (drafts; server-side only)
STORYBLOK_PUBLIC_TOKEN=               # Public access token (published content), optional
# Management API: modeling/seeding scripts only, never used by the storefront
STORYBLOK_OAUTH_TOKEN=

# --- BigCommerce (Storefront GraphQL, channel-scoped token) -----------------
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=         # created per origin (http://localhost:3000, production domain)
